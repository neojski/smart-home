{
  "scripts": {
    "check-compilation": "tsc -p tsconfig.json",
    "ui-build": "esbuild ui/mirror.tsx --bundle --outfile=dist/bundle.js --target=es2020",
    "ui-dev": "xdg-open ui/index.html && npm run ui-build -- --watch",
    "test": "docker run --rm -v \"$PWD\":/work -w /work --ipc=host --user \"$(id -u):$(id -g)\" -e HOME=/tmp mcr.microsoft.com/playwright:v1.62.1-noble npx vitest run",
    "test:vitest": "vitest run",
    "test:update": "docker run --rm -v \"$PWD\":/work -w /work --ipc=host --user \"$(id -u):$(id -g)\" -e HOME=/tmp mcr.microsoft.com/playwright:v1.62.1-noble npx vitest run --update",
    "check-prettier": "prettier '**/*.{ts,tsx}' --check",
    "prettier": "prettier --write '**/*.{ts,tsx}'"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/browser-playwright": "^4.1.11",
    "esbuild": "^0.28.2",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  }
}

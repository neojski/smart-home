{
  "scripts": {
    "check-compilation": "tsc -p tsconfig.json",
    "ui-build": "esbuild ui/mirror.tsx --bundle --outfile=dist/bundle.js --target=es2020",
    "ui-dev": "xdg-open ui/index.html && npm run ui-build -- --watch",
    "test": "npm run check-compilation && prettier '**/*.{ts,tsx}' --check && vitest run",
    "prettier": "prettier --write '**/*.{ts,tsx}'"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}

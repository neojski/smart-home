{
  "compilerOptions": {
    "strict": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": true,
    "noUnusedParameters": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "alwaysStrict": true,
    "esModuleInterop": true,
    // Keep in sync with esbuild's --target in the ui-build script.
    "lib": ["ES2020", "DOM"],
    "target": "ES2020",

    "moduleResolution": "bundler",
    "types": ["vitest/globals"],
    "jsx": "react-jsx",

    "skipLibCheck": true,

    // esbuild bundles; tsc only typechecks.
    "noEmit": true,
    "module": "ESNext",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
  },

  "include": ["ui"]
}
